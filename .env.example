# ============================================================
# TTS 朗读 — 运行参数
#
# 改参数只改本文件，不要改代码里的硬编码值
# 优先级：环境变量 > 本文件 > 代码兜底默认值
# 写法：KEY=VALUE；注释只能是整行（# 开头）；值不加引号、行尾不留空格、值内不放 "="
# 存盘：UTF-8 无 BOM + CRLF（cmd 的 for /f 只认 CRLF，存成 LF 整个文件读不进来）
# ============================================================

# ---------------------------- 路径 ----------------------------

# 模型目录（onnx-community/Kokoro-82M-v1.1-zh-ONNX：model.onnx + config.json + voices/）
TTS_MODEL_DIR=C:\tts\models\Kokoro-ONNX-v1.1-zh

# 音色目录：现只留 zf_001 / zm_029 两个 .bin（裸 float32 [510,256]），要补去魔搭下同名文件
TTS_VOICES_DIR=C:\tts\models\Kokoro-ONNX-v1.1-zh\voices

# 合成缓存：同一段文字重复朗读直接命中，省掉重算
TTS_CACHE_DIR=C:\tts\cache

# ---------------------------- 模型 ----------------------------

# ONNX 权重（绝对路径；也可只写相对 TTS_MODEL_DIR 的文件名）
TTS_ONNX_MODEL=C:\tts\models\Kokoro-ONNX-v1.1-zh\onnx\model.onnx

# 启动自检：SHA256 对不上就拒绝启动，BYTES 是快速预检（2026-10-27 实测值）
TTS_ONNX_SHA256=94b973941b1852754f979be5d5e20be666d5c81d9bb886b88ae1dc85c9b895ca
TTS_ONNX_BYTES=339369442

# 采样率：模型原生 24k，全链路不要重采样
TTS_SAMPLE_RATE=24000

# G2P 版本：必须 1.1（中文优化）。漏了不报错，只会把四声吞掉
TTS_G2P_VERSION=1.1

# ---------------------------- 中文修正 ----------------------------

# 开 core/zh_patch.py 的变调修正，修 misaki「跨词边界的同字被当重叠词读轻声」
# ⚠️ 关掉 =「银行行长」「一串串」念错，除非做 A/B 取证，别关
TTS_ZH_PATCH=on

# ---------------------------- 音色（仅本地引擎） ----------------------------

# 女声 / 男声：都是 0 八度跳变的验收锚点
# ⚠️ 旧选择的 zf_073 最大跳 20 半音（听感跑调）、zm_065 池内第 97 名，均已弃
TTS_VOICE_FEMALE=zf_001
TTS_VOICE_MALE=zm_029

# 默认音色：female / male（讯飞引擎不吃这两项，它走下面的 TTS_XFYUN_VOICE_*）
TTS_VOICE_DEFAULT=female

# ============================================================
#                    引擎选择
#   合成三选一：本地 ONNX / 讯飞在线 / Edge 在线（托盘「语音引擎」随时切，
#   切完自动重启服务进程，10 秒内生效）
#   识别的引擎在托盘「识别引擎」里单独切：本地 SenseVoice / 讯飞听写
# ============================================================

# 合成引擎：local = 本地 ONNX（~820MB，离线，音质一般）
#           xfyun = 讯飞在线（~100MB，免费额度按次算，每日 500 次）
#           edge  = Edge 在线（~100MB，免费不限量，音质最好，端点境外）
TTS_ENGINE=xfyun

# ---------------------------- 讯飞凭据 ----------------------------

# 控制台 → 我的应用 → 语音合成 / 语音听写 → 服务接口认证信息
TTS_XFYUN_APPID=你的 AppID
TTS_XFYUN_API_KEY=
TTS_XFYUN_API_SECRET=
# 新控制台另给的 API 密码（ak- 开头）：http 协议没单独配 key 时拿它当 Bearer
TTS_XFYUN_API_PASSWORD=

# ---------------------------- 合成协议 ----------------------------

# ws      = 官方 WebAPI（wss + HMAC 签名，默认，实测最稳）
# http    = 自建代理 / 兼容服务（POST JSON + Bearer）
# ws,http = 先 ws，失败自动回落 http（http 地址没填就等于纯 ws）
TTS_XFYUN_PROTOCOL=ws

# 官方 WebAPI 地址（必须带 /v2/tts；换域名/端口只动这一行）
TTS_XFYUN_WS_URL=wss://tts-api.xfyun.cn/v2/tts
# http 协议用：POST 该地址，body {"text","voice","rate","app_id"}，
# 响应支持三种形态：音频字节 / {"audio":"<base64>"} / {"url":"..."}
TTS_XFYUN_HTTP_URL=
TTS_XFYUN_HTTP_KEY=

# 输出格式：raw 裸 PCM。24k 按发音人分开授权（2026-10-29 实测）：
#   支持 24k：x4_yezi / aisjiuxu / aisxping / aisjinger / aisbabyxu
#   不支持  ：xiaoyan / xiaofeng（返回 code=0 但空音频，引擎会自动回落 16k 并记住）
TTS_XFYUN_AUF=audio/L16;rate=24000

# 1.0× 对应的讯飞 speed（0~100，50 = 自然语速），倍速按它线性缩放
# 46 = 比标准慢半档，老发音人在 50 上赶得像播报
# 44 = 比标准慢一档。免费老发音人在 50 上又赶又平，慢下来才有一点「说」的感觉
TTS_XFYUN_SPEED_BASE=44
# 音高 / 音量（0~100，50 = 默认）。音高降 → 更沉更稳，升 → 更亮更年轻
# 48 = 略微下沉。老发音人音高偏高时电子味明显，压低一点更稳
TTS_XFYUN_PITCH=48
TTS_XFYUN_VOLUME=55
# 块尾补句号（1 开 / 0 关）：切块硬切断时补一个「。」让语调自然下沉收住，
# 关掉就会出现「半句话被掐断」的平调
TTS_XFYUN_TAIL_PUNCT=1
# 单次调用文本上限（字）：官方 <8000 字节 ≈ 2000 汉字，留点余量
TTS_XFYUN_MAX_CHARS=1800
# 单次请求超时（秒）
TTS_XFYUN_TIMEOUT=20

# ---------------------------- 讯飞切块（与本地分开） ----------------------------

# 讯飞按「句」打包：句号才切，逗号绝不切（本地那套会为速度把句子切碎，听着断）
# 首块：至少一整句，攒到 FIRST 字为止（18 字约多花 0.3s 首字时间）
# 首块 30 字：让第一句通常整句合成，不被句中硬切（切一刀就是一个假句号 + 300ms 静音，
# 听着就是「卡」）。首字延迟约 +0.5s，换整句连贯
TTS_XFYUN_FIRST_CHUNK_MAX=30
# 后续每块攒到这么多字（字越多越连贯，也越省每日 500 次额度）
TTS_XFYUN_CHUNK_MAX=80
# ≤ 这么多字整段一次合成（0 = 关）。想更连贯可以设 60，代价是首字变慢
TTS_XFYUN_NOSPLIT_CHARS=0

# 块间静音（毫秒）：讯飞每块独立合成，50ms 听着像连读硬切，300ms 才有换气感
# 这是「没有停顿」最直接的旋钮，嫌拖就调到 200，嫌赶就调到 400
TTS_XFYUN_CHUNK_GAP_MS=300

# ---------------------------- 讯飞音色 ----------------------------

# 逻辑音色 female / male → 具体 vcn
# 免费基础发音人就 5 个（小燕/许久/小萍/小婧/许小宝），都是 2016 年的老模型，听感生硬；
# 本账号实测 x4_yezi 可用（真 24k、0.47s 出音），语调停顿明显自然一档，故设为默认女声
#
# ⚠ 名字对照（讯飞有两个「小露」，容易搞混）：
#   x4_yezi          = 官方说的「小露」（长文本合成 API 与虚拟人 API 的发音人表都写作 小露 → x4_yezi）
#                      也就是界面上叫「叶子」的那个，本账号已授权
#   x4_lingxiaolu    = 「聆小璐」，另一个音色，本账号**未开通**（实测 11200 licc failed）
#                      想用得先去控制台付费/试用开通，然后在下面 VOICES 里加 x4_lingxiaolu:聆小璐
TTS_XFYUN_VOICE_FEMALE=x4_yezi
TTS_XFYUN_VOICE_MALE=aisjiuxu
# 授权失效时的兜底发音人：超拟人/特色音色是限时试用，到期会返回 11200 licc failed，
# 这时自动换成这个永久免费的基础发音人继续念（不会弹错、不会中断朗读）
TTS_XFYUN_FALLBACK_VOICE=xiaoyan

# 浮窗 / 托盘下拉列出的音色："vcn:显示名" 逗号分隔，可自由增删（越靠前越靠上）
# ⚠ 只列实测有授权的：其他 vcn（x4_lingxiaolu、x4_yeting、x4_pengfei…）会报 11200 licc failed
TTS_XFYUN_VOICES=x4_yezi:小露·超拟人,aisxping:小萍·女,aisjinger:小婧·女,xiaoyan:小燕·女,aisjiuxu:许久·男,xiaofeng:小峰·男,aisbabyxu:许小宝·童


# ---------------------------- Edge 在线（第三个合成引擎） ----------------------------

# 走微软 Edge 浏览器「大声朗读」的端点，不用注册、不要 key、不计次。
# 音质是目前几个里最好的（和 Azure 神经语音同一批模型），中文音色几十个。
# 代价：服务器在境外，断网/网络不稳就没了；首字比讯飞慢（每次合成都要重新握手，
# 实测 1.2~1.5s 出音），所以适合「听长文」，不适合「一句话快速听」。

# 代理：留空 = 直连（本机实测直连 1.2s 出音，够用）。
# 直连不通时填本地代理，例如 http://127.0.0.1:7890
# 只影响 Edge 引擎，不动系统代理，也不影响讯飞/本地引擎。
TTS_EDGE_PROXY=

# 单次合成文本上限（字）：超长文本端点会中途断流，正常切块只有 60~80 字
TTS_EDGE_MAX_CHARS=2000
# 超时（秒）：connect=握手，receive=收音频；境外线路抖一下很正常，给宽点
TTS_EDGE_CONNECT_TIMEOUT=10
TTS_EDGE_TIMEOUT=30
# 失败重试次数（0 = 不重试）。端点偶发 403/断流，重试一次基本都能过
TTS_EDGE_RETRY=1

# 1.0× 对应的相对语速（%）。Edge 默认语速偏快，朗读长文可以设 -5
TTS_EDGE_RATE_BASE=0
# 音量 = 相对百分比（"+0%"）；音高 = 绝对频偏，**必须带 Hz**（"+0Hz"）
# 音高写成 % 会被端点直接拒（Invalid pitch）；音高别乱调，±10Hz 就开始不像真人
TTS_EDGE_VOLUME=+0%
TTS_EDGE_PITCH=+0Hz

# 逻辑音色 female / male → Neural 音色名
# 晓晓 = 最自然的中文女声；云健 = 男声里最适合长篇朗读的（沉稳不飘）
# 全部音色可跑 `python -m edge_tts --list-voices` 看（中文几十个）
TTS_EDGE_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
TTS_EDGE_VOICE_MALE=zh-CN-YunjianNeural
# 浮窗 / 托盘下拉列出的音色："音色名:显示名" 逗号分隔，可自由增删
TTS_EDGE_VOICES=zh-CN-XiaoxiaoNeural:晓晓·女（自然）,zh-CN-XiaoyiNeural:晓伊·女（活泼）,zh-CN-YunjianNeural:云健·男（沉稳）,zh-CN-YunxiNeural:云希·男（年轻）,zh-CN-YunyangNeural:云扬·男（播报）,zh-CN-liaoning-XiaobeiNeural:晓北·女（东北）,zh-CN-shaanxi-XiaoniNeural:晓妮·女（陕西）,zh-HK-HiuMaanNeural:曉曼·女（粤语）,zh-TW-HsiaoChenNeural:曉臻·女（台湾）

# ---- Edge 切块（和讯飞同一套「按句打包」，只是块更小） ----
# 不限量，不用为省次数攒大块：小块起播快、跳转粒度细、断流损失小
TTS_EDGE_FIRST_CHUNK_MAX=24
TTS_EDGE_CHUNK_MAX=60
# ≤ 这么多字整段一次合成（0 = 关）
TTS_EDGE_NOSPLIT_CHARS=0
# 块间静音（毫秒）：每块独立合成，靠留白做「换气」。嫌拖 200，嫌赶 400
TTS_EDGE_CHUNK_GAP_MS=250
# 块尾补句号（1 开 / 0 关）：硬切断时让语调自然收住
TTS_EDGE_TAIL_PUNCT=1

# ---------------------------- 语速 ----------------------------

# 基础语速：对齐官方 make_zh.py 的 speed*1.1（早期长句降到 0.85 是「拖、板」主因，已废）
TTS_SPEED_BASE=1.1

# 长句降速：音素数 > FROM 开始线性降，到 FLOOR 触底，SLOPE 为斜率
TTS_SPEED_LONG_FROM=83
TTS_SPEED_LONG_FLOOR=183
TTS_SPEED_SLOPE=500

# ---------------------------- 切块 ----------------------------

# 逐块上限（字）：前四块分别 ≤8/10/20/40，之后回落到 TTS_CHUNK_MAX
# 只压首块没用——第二块不变小时起播门槛会把它等回来（实测首块 6 字反而 3.2s）
# 想更连贯就改 10,14,30,60（首字约 1.55s）；留空 = 回到下面 FIRST/SECOND 老规则
TTS_CHUNK_RAMP=8,10,20,40

# 老规则，仅 CHUNK_RAMP 留空时生效：首块 / 第二块上限（字）
TTS_FIRST_CHUNK_MAX=10
TTS_SECOND_CHUNK_MAX=14

# 后续块上限（字）：按句子打包，超过就断块
TTS_CHUNK_MAX=60

# 整句合成阈值（字，0 = 关）：0 首字最快；设 40 = 40 字内整句，语调最连贯但首字 1.0s→2.3s
TTS_NOSPLIT_CHARS=0

# 块间静音（毫秒）：0 会让句子黏在一起，太长会拖
# 本地引擎用这一项；讯飞用下面的 TTS_XFYUN_CHUNK_GAP_MS（每块独立合成，要留更多白）
TTS_CHUNK_GAP_MS=50

# ---------------------------- 服务 ----------------------------

# 监听地址与端口（llama-server 用 9527，错开避免冲突）
TTS_HOST=127.0.0.1
TTS_PORT=9528

# 推理线程数：8 个物理核。实测 16 线程（超线程）反而慢 20-40%，别改成 16
TTS_THREADS=8

# 启动预热：盖掉首请求 ~0.5s 的一次性开销，关掉第一个请求会明显慢
TTS_WARMUP=on
TTS_WARMUP_TEXT=预热。

# ---------------------------- 缓存 ----------------------------

# 上限（MB），超了按最久未用淘汰
TTS_CACHE_MAX_MB=200

# 缓存键的盐：改了等于旧缓存全失效（调音色 / 语速后改这里）
# 改了音色/语速/音高/切块后必须换 salt，否则同文本命中的还是旧音频（听着像「没生效」）
# 在线引擎的参数已自动进 key（见 config.CACHE_SALT 拼接），这里只在换音色时手动改
TTS_CACHE_SALT=v2-xfyun-prosody

# ---------------------------- 播放 / 倍速 ----------------------------

# 默认倍速（用户可见档位；内部 1.0× 对应真实 speed 1.1，不要暴露内部值）
TTS_RATE_DEFAULT=1.0

# 自定义倍速范围：浮窗输入框按它校验，偏好存盘也按它兜底
TTS_RATE_MIN=0.5
TTS_RATE_MAX=3.0

# 预取低水位 / 高水位（秒）：太低会断流——60 字块要 ~5s 合成，只按 3s 预取接不上
TTS_PREFETCH_S=3.0
TTS_BUFFER_HIGH_S=20

# 起播门槛上限（秒）：预计第二块来不及就先攒缓冲再出声，宁可首字慢也不断流；0 = 关
TTS_START_GATE_MAX_S=2.5

# 保留多少个朗读任务（含音频），断点续播靠它，超出按最旧淘汰
TTS_TASK_KEEP=20

# ---------------------------- 选中浮窗 ----------------------------

# 划完词在鼠标旁弹「朗读」按钮，点一下就念；0 = 关掉，只用 Alt+右键
TTS_BUBBLE=1

# 松手后延迟取字（拖选刚结束时应用的选区状态有时还没同步完）
TTS_BUBBLE_DELAY_MS=180

# 无人理会多久自动消失（毫秒）
TTS_BUBBLE_HIDE_MS=4000

# 少于这么多字不弹（避免点一下光标就冒出来）
TTS_BUBBLE_MIN_CHARS=2

# ---------------------------- 语音输入（ASR） ----------------------------

# 总开关：按住 Alt 说话，松开自动识别并打进光标处（托盘可临时开关）
ASR_ENABLE=on

# 模型：sensevoice（中文精度高、带标点）| streaming_zipformer（流式，需自备模型）
ASR_MODEL_TYPE=sensevoice

# 精度档：int8（228MB / 常驻 299MB）| fp32（894MB / 956MB）。实测输出逐字一致 → 默认 int8
ASR_VARIANT=int8

# 模型目录：留空则按 类型 + 精度档 自动选
#ASR_MODEL_DIR=

# 逆文本正则化（SenseVoice 专用）：数字转阿拉伯字、加标点
ASR_USE_ITN=on
ASR_THREADS=2

# 采集采样率：模型固定吃 16k，设备不支持时回退设备默认率再重采样
ASR_SAMPLE_RATE=16000

# Alt 宽限期（毫秒）：期内出现 Alt+右键 / Alt+Tab 就取消 PTT，互不干扰
ASR_PTT_GRACE_MS=250

# 单次录音上限（秒），到达按松手处理
ASR_MAX_S=60

# 识别结果少于这么多字不打进光标（误触保护）
ASR_MIN_CHARS=1

# ---------------------------- 讯飞听写（在线识别） ----------------------------

# 识别引擎：local（本地 SenseVoice，常驻 299MB，离线）| xfyun（讯飞听写，联网）
# 这里只是 pref.json 里没有记录时的初值；托盘「识别引擎」切换结果会存盘
ASR_ENGINE=xfyun

# 凭据三项留空 = 沿用上面 TTS_XFYUN_* 那一套（同一个应用就够）
ASR_XFYUN_APPID=
ASR_XFYUN_API_KEY=
ASR_XFYUN_API_SECRET=

# 协议：ws（听写流式，边录边出字，默认）| http（整段上传，需自备接口）| ws,http
ASR_XFYUN_PROTOCOL=ws
ASR_XFYUN_WS_URL=wss://iat-api.xfyun.cn/v2/iat
# http 兜底：POST {"audio":"<wav base64>","sample_rate":16000} → {"text":"..."}
ASR_XFYUN_HTTP_URL=
ASR_XFYUN_HTTP_KEY=
# 口音：mandarin（普通话）| cantonese | sichuanese | henanese ...
ASR_XFYUN_ACCENT=mandarin
# 建连接超时（秒）：按住 Alt 后要等握手完成才出字，太大会像「没反应」
ASR_XFYUN_CONNECT_TIMEOUT=8
